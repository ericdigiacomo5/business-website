// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

model Service {
  id              String   @id @default(cuid())
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  appointments          Appointment[]
  recurringAppointments RecurringAppointment[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())

  appointments          Appointment[]
  accounts              Account[]
  sessions              Session[]
  recurringAppointments RecurringAppointment[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Artist {
  id        String   @id @default(cuid())
  name      String
  bio       String?
  photoUrl  String?
  createdAt DateTime @default(now())

  portfolio             PortfolioImage[]
  availability          Availability[]
  timeOff               TimeOff[]
  appointments          Appointment[]
  slots                 AppointmentSlot[]
  recurringAppointments RecurringAppointment[]
}

model PortfolioImage {
  id        String   @id @default(cuid())
  artistId  String
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())

  artist Artist @relation(fields: [artistId], references: [id])
}

// Scheduling
enum AppointmentStatus {
  UPCOMING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model RecurringAppointment {
  id            String          @id @default(cuid())
  userId        String
  artistId      String
  serviceId     String
  dayOfWeek     Int
  startTime     String
  intervalWeeks Int
  seriesStart   DateTime
  seriesEnd     DateTime?
  status        RecurringStatus @default(ACTIVE)
  createdAt     DateTime        @default(now())

  user         User          @relation(fields: [userId], references: [id])
  artist       Artist        @relation(fields: [artistId], references: [id])
  service      Service       @relation(fields: [serviceId], references: [id])
  appointments Appointment[]
}

model Appointment {
  id                     String            @id @default(cuid())
  userId                 String
  artistId               String
  serviceId              String
  startTime              DateTime
  endTime                DateTime
  status                 AppointmentStatus @default(UPCOMING)
  createdAt              DateTime          @default(now())
  recurringAppointmentId String?

  user                 User                  @relation(fields: [userId], references: [id])
  artist               Artist                @relation(fields: [artistId], references: [id])
  service              Service               @relation(fields: [serviceId], references: [id])
  slots                AppointmentSlot[]
  recurringAppointment RecurringAppointment? @relation(fields: [recurringAppointmentId], references: [id])
}

model AppointmentSlot {
  id            String   @id @default(cuid())
  artistId      String
  slotStart     DateTime
  appointmentId String

  artist      Artist      @relation(fields: [artistId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@unique([artistId, slotStart])
}

model Availability {
  id        String @id @default(cuid())
  artistId  String
  dayOfWeek Int
  startTime String
  endTime   String

  artist Artist @relation(fields: [artistId], references: [id])
}

model TimeOff {
  id        String   @id @default(cuid())
  artistId  String
  date      DateTime
  startTime String
  endTime   String

  artist Artist @relation(fields: [artistId], references: [id])
}
