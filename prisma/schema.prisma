// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ServiceType {
  HANDS
  FEET
  WAX
}

model Service {
  id              String      @id @default(cuid())
  name            String
  description     String?
  category        ServiceType
  durationMinutes Int
  priceCents      Int
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())

  appointmentServices          AppointmentService[]
  recurringAppointmentServices RecurringAppointmentService[]
  payTerms                     ServicePayTerms?
  artists                      ArtistService[]
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  phone              String
  passwordHash       String?
  // Stamped on every successful password reset. Compared against a JWT
  // session's `iat` claim in src/auth.ts so a reset invalidates any session
  // that predates it — the JWT strategy has no server-side session row to
  // delete, so this is the substitute revocation mechanism. Null means
  // "never reset," which correctly invalidates nothing.
  passwordChangedAt  DateTime?
  // Stamped by "Sign out of all devices" (the customer's own, or an admin's
  // for a customer). Checked the same way as passwordChangedAt: any session
  // issued before it is rejected on its next request.
  sessionsRevokedAt  DateTime?
  role               Role      @default(CUSTOMER)
  createdAt          DateTime  @default(now())
  // Store credit (from redeemed gift cards), in cents. A cache of
  // SUM(CreditEntry.amountCents) for this user, written only by
  // src/lib/credit.ts in the same transaction as the ledger row. A CHECK
  // constraint (hand-written in the migration) keeps it from going below 0.
  creditBalanceCents Int       @default(0)

  // Text messages (SMS), opt-in only — never pre-checked, never required to
  // book. All changes go through src/lib/sms-consent-data.ts. Texts are sent
  // only when smsOptIn is true AND the customer has replied YES from
  // smsPhone (double opt-in), so a mistyped or someone else's number never
  // gets appointment texts. Changing the profile phone turns texts off.
  smsOptIn              Boolean   @default(false)
  // The number (E.164, "+16315550143") the consent is for — the profile
  // phone at the time the box was ticked.
  smsPhone              String?
  // When a YES reply arrived from smsPhone. Null = not confirmed yet.
  smsConfirmedAt        DateTime?
  // When the "Reply YES" text was sent. Null while opted in means it still
  // has to go (texting wasn't configured yet, or the send failed); the
  // reminder job picks those up.
  smsConfirmRequestedAt DateTime?

  appointments            Appointment[]
  accounts                Account[]
  sessions                Session[]
  recurringAppointments   RecurringAppointment[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  creditEntries           CreditEntry[]            @relation("CreditEntryUser")
  creditEntriesCreated    CreditEntry[]            @relation("CreditEntryCreatedBy")
  giftCardsIssued         GiftCard[]               @relation("GiftCardIssuedBy")
  giftCardsRedeemed       GiftCard[]               @relation("GiftCardRedeemedBy")
  giftCardsVoided         GiftCard[]               @relation("GiftCardVoidedBy")
  smsConsentEvents        SmsConsentEvent[]
  smsMessages             SmsMessage[]

  @@index([smsPhone])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Deliberately separate from VerificationToken above, even though that table
// is currently unused (it exists only for Auth.js's Email/magic-link
// provider, which this project doesn't use). Reusing it would mean storing a
// hashed reset token in a table Auth.js semantically owns — its composite PK
// has no userId relation and no "used" column — and the two purposes would
// collide the moment an email-verification provider is ever added.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  // SHA-256 hash of the token, never the plaintext — a DB leak would
  // otherwise hand over live account takeover. Unique because it's looked up
  // directly by hash (the plaintext, only ever known to the emailed link,
  // never touches the database).
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Cascade, not this schema's usual RESTRICT default — same reasoning as
  // Account/Session above: a reset token has no independent meaning once its
  // user is gone.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Proof that someone controls an email address: sent at registration (email
// = the account's own address) and when a signed-in user changes their
// address (email = the new one, which only replaces User.email once the link
// is used). Same storage rules as PasswordResetToken — only the SHA-256 of
// the token, single use, short expiry.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  // The address this token proves. Lowercased like User.email.
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Cascade, same as PasswordResetToken: meaningless without its user.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Artist {
  id        String   @id @default(cuid())
  name      String
  bio       String?
  photoUrl  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  portfolio             PortfolioImage[]
  availability          Availability[]
  timeOff               TimeOff[]
  appointments          Appointment[]
  slots                 AppointmentSlot[]
  recurringAppointments RecurringAppointment[]
  payTerms              ArtistPayTerms?
  // The services this artist performs. No rows = every service (the
  // default, so an artist added before this existed, or one who does it
  // all, needs no setup) — see src/lib/artist-services.ts.
  services              ArtistService[]
}

// One service an artist performs (FEATURE_GAPS.md Gap 23). Customers can
// only book an artist for services they perform; admins are warned but may
// override. Artists and services are never hard-deleted (they deactivate),
// so the cascades only matter for test data.
model ArtistService {
  artistId  String
  serviceId String

  artist  Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([artistId, serviceId])
  @@index([serviceId])
}

model PortfolioImage {
  id        String   @id @default(cuid())
  artistId  String
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())

  artist Artist @relation(fields: [artistId], references: [id])
}

// Scheduling
enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// A standing appointment can only be cancelled — there is no pause and no
// editing. Individual occurrences are ordinary Appointments and are
// rescheduled/cancelled like any other.
enum RecurringStatus {
  ACTIVE
  CANCELLED
}

// How an appointment's price is reduced. PERCENT: discountValue is a whole
// percentage (1-100). AMOUNT: discountValue is cents off.
enum DiscountType {
  PERCENT
  AMOUNT
}

// How the part of the bill left after discount and store credit was paid.
// GROUPON: the customer showed a Groupon voucher, which staff redeem in
// Groupon's Merchant Center — this app records only that it was the form of
// payment, nothing about the voucher itself.
enum PaymentMethod {
  CASH
  CARD
  GROUPON
  OTHER
}

model RecurringAppointment {
  id            String          @id @default(cuid())
  userId        String
  artistId      String
  dayOfWeek     Int
  startTime     String
  intervalWeeks Int
  seriesStart   DateTime
  // Required: every week from seriesStart through seriesEnd is booked (or
  // recorded as skipped) when the series is created — nothing extends a
  // series afterward.
  seriesEnd     DateTime
  status        RecurringStatus @default(ACTIVE)
  createdAt     DateTime        @default(now())

  user               User                          @relation(fields: [userId], references: [id])
  artist             Artist                        @relation(fields: [artistId], references: [id])
  // One or more services, in order — every visit of the series is booked
  // with all of them.
  services           RecurringAppointmentService[]
  appointments       Appointment[]
  skippedOccurrences RecurringSkippedOccurrence[]
}

// One service of a standing appointment. No price/duration snapshot here:
// each visit takes its own snapshot when it is booked (see
// AppointmentService), which is at series creation.
model RecurringAppointmentService {
  id                     String @id @default(cuid())
  recurringAppointmentId String
  serviceId              String
  position               Int

  // Cascade, same reasoning as RecurringSkippedOccurrence: a line means
  // nothing without its series.
  recurringAppointment RecurringAppointment @relation(fields: [recurringAppointmentId], references: [id], onDelete: Cascade)
  service              Service              @relation(fields: [serviceId], references: [id])

  @@unique([recurringAppointmentId, serviceId])
}

// A week of a standing appointment that couldn't be booked (a conflict, the
// artist was deactivated, ...). Recorded once and never retried, so it can
// be shown on the series and emailed to the customer exactly once.
model RecurringSkippedOccurrence {
  id                     String   @id @default(cuid())
  recurringAppointmentId String
  // "YYYY-MM-DD", same identity format as Appointment.occurrenceDate.
  occurrenceDate         String
  reason                 String
  createdAt              DateTime @default(now())

  // Cascade, a deliberate exception to this schema's RESTRICT default (same
  // reasoning as Account/Session): a skip record means nothing without its
  // series.
  recurringAppointment RecurringAppointment @relation(fields: [recurringAppointmentId], references: [id], onDelete: Cascade)

  @@unique([recurringAppointmentId, occurrenceDate])
}

model Appointment {
  id                     String            @id @default(cuid())
  userId                 String
  artistId               String
  startTime              DateTime
  endTime                DateTime
  status                 AppointmentStatus @default(PENDING)
  createdAt              DateTime          @default(now())
  recurringAppointmentId String?
  paymentMethod          PaymentMethod?
  checkedOutAt           DateTime?
  // Optional discount an admin applied before checkout — both set or both
  // null. Record-keeping only, like checkout itself: the POS takes the
  // payment, this is what the receipt and the schedule show. The total is
  // derived from the services' booked prices (see src/lib/discount.ts), not
  // stored.
  discountType           DiscountType?
  discountValue          Int?
  // Store credit spent on this visit at checkout, in cents (0 = none).
  // Written only in the same transaction as the matching SPENT / REVERSED
  // CreditEntry rows, so it always equals minus their sum. Kept on the row
  // so every view of the appointment can show "Due" without the ledger.
  creditAppliedCents     Int               @default(0)
  // Set once the 24h reminder email has gone out (or once some other email
  // already told the customer about an imminent time — see
  // src/lib/appointment-emails.ts). The reminder job claims rows by flipping
  // this from null, so a reminder can never send twice. Reset to null on
  // reschedule, since the old reminder was for the old time.
  reminderSentAt         DateTime?
  // The same claim for the 24h reminder *text*, kept separate so an email
  // and a text can each be sent (and retried) on their own. Reset with
  // reminderSentAt on reschedule.
  smsReminderSentAt      DateTime?
  // Which week of its series this row was materialized for ("YYYY-MM-DD"),
  // null for one-off appointments. Set once and never changed by a
  // reschedule, so a moved occurrence still counts as "handled" for its
  // original date. A string rather than a DateTime on purpose: it's compared
  // by exact equality, and a DateTime "date" is local midnight stored as a
  // UTC instant, which can silently fail to match if computed differently.
  occurrenceDate         String?

  user                 User                  @relation(fields: [userId], references: [id])
  artist               Artist                @relation(fields: [artistId], references: [id])
  // One or more services, in order. The appointment's price is the sum of
  // their booked prices; its usual length is the sum of their durations
  // (startTime..endTime is still the truth for the actual length).
  services             AppointmentService[]
  slots                AppointmentSlot[]
  recurringAppointment RecurringAppointment? @relation(fields: [recurringAppointmentId], references: [id])
  creditEntries        CreditEntry[]
  pay                  AppointmentPay?
  smsMessages          SmsMessage[]

  // Each week of a series can be materialized at most once — the database,
  // not careful call-site logic, is what makes a concurrent job run or a
  // job racing a Resume click harmless (same instinct as AppointmentSlot's
  // unique constraint). Postgres treats NULLs as distinct, so one-off
  // appointments (both columns null) are unaffected.
  @@unique([recurringAppointmentId, occurrenceDate])
}

// One service on an appointment. priceCents and durationMinutes are copied
// from the Service when the line is added, so a past appointment (and its
// receipt) keeps what it was booked at even if the service is repriced later.
model AppointmentService {
  id              String @id @default(cuid())
  appointmentId   String
  serviceId       String
  position        Int
  priceCents      Int
  durationMinutes Int

  // Cascade: a line means nothing without its appointment. The Service side
  // stays RESTRICT — a booked service is retired via Service.active, never
  // deleted.
  appointment Appointment            @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service                @relation(fields: [serviceId], references: [id])
  pay         AppointmentServicePay?

  @@unique([appointmentId, serviceId])
}

model AppointmentSlot {
  id            String   @id @default(cuid())
  artistId      String
  slotStart     DateTime
  appointmentId String

  artist      Artist      @relation(fields: [artistId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@unique([artistId, slotStart])
}

model Availability {
  id        String @id @default(cuid())
  artistId  String
  dayOfWeek Int
  startTime String
  endTime   String

  artist Artist @relation(fields: [artistId], references: [id])
}

model TimeOff {
  id        String    @id @default(cuid())
  // Nullable = salon-wide (blocks every artist, present and future — see
  // PLAN_SALON_CLOSURES.md for why this beats a list of artist ids: a list
  // has to be re-populated by hand every time staff changes, while null
  // covers everyone with zero maintenance). A concrete id keeps the original
  // per-artist behavior unchanged.
  artistId  String?
  date      DateTime
  // Nullable = single-day (today's behavior, unchanged). A value makes the
  // range [date, endDate] inclusive — a multi-day closure without needing
  // one row per day.
  endDate   DateTime?
  startTime String
  endTime   String

  artist Artist? @relation(fields: [artistId], references: [id])
}

// Store credit and gift cards. This app never takes money: a gift card is
// paid for at the POS, and credit only reduces what the POS charges later.
// What's recorded here is value the salon owes its customers, so every
// change goes through src/lib/credit.ts — see PLAN_GIFT_CARDS_AND_VOUCHERS.md.

enum CreditEntryKind {
  GIFT_CARD // + a gift card's value moved onto the account
  SPENT // − applied to an appointment at checkout
  REVERSED // + credit spent on an appointment, given back
  ADJUSTMENT // ± manual correction by an admin; note required
}

// Append-only ledger: rows are never updated or deleted. A correction is a
// new, opposite entry. User.creditBalanceCents caches the sum per user.
// RESTRICT foreign keys throughout, so nothing can cascade into the history.
model CreditEntry {
  id            String          @id @default(cuid())
  userId        String
  // Signed: positive adds credit, negative spends it.
  amountCents   Int
  kind          CreditEntryKind
  giftCardId    String?
  appointmentId String?
  note          String?
  // The admin who made the change, or the customer for a self-redeem.
  createdById   String
  createdAt     DateTime        @default(now())

  user        User         @relation("CreditEntryUser", fields: [userId], references: [id])
  createdBy   User         @relation("CreditEntryCreatedBy", fields: [createdById], references: [id])
  // Restrict spelled out: Prisma's default for an optional relation is
  // SET NULL, which would quietly unlink history.
  giftCard    GiftCard?    @relation(fields: [giftCardId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

enum GiftCardStatus {
  ISSUED
  REDEEMED
  VOID
}

// A gift card sold at the desk as a printed code. Redeeming moves its whole
// value onto one account, once; after that the card has no balance of its
// own. Never expires and never charges fees (NY gift card law).
model GiftCard {
  id               String         @id @default(cuid())
  // SHA-256 of the normalized code — the plaintext is shown once, to be
  // printed, and never stored (same reasoning as PasswordResetToken). A
  // database leak then doesn't hand out spendable codes.
  codeHash         String         @unique
  // So staff can find a card ("the $50 one ending 2PNB") and void it.
  codeLast4        String
  valueCents       Int
  status           GiftCardStatus @default(ISSUED)
  purchaserName    String?
  recipientName    String?
  issuedById       String
  issuedAt         DateTime       @default(now())
  redeemedByUserId String?
  redeemedAt       DateTime?
  voidedAt         DateTime?
  voidReason       String?
  // The admin who voided it. Null on cards voided before this was recorded.
  voidedById       String?

  issuedBy      User          @relation("GiftCardIssuedBy", fields: [issuedById], references: [id])
  redeemedBy    User?         @relation("GiftCardRedeemedBy", fields: [redeemedByUserId], references: [id], onDelete: Restrict)
  voidedBy      User?         @relation("GiftCardVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  creditEntries CreditEntry[]

  @@index([issuedAt])
}

// Artist pay (the pay report, /admin/reports/pay — see
// PLAN_ARTIST_PAY_REPORT.md). Kept in tables of their own rather than as
// columns on Artist / Service / Appointment / AppointmentService on purpose:
// those rows are read with plain `include: { artist: true }` and
// findMany()s by public pages and customer API responses, so a column there
// would hand every customer the artists' pay terms. Nothing outside the
// admin pay pages and checkout reads these tables.

// An artist's commission, as a share of what clients paid for their
// services after discounts. No row = not set yet: the report then shows the
// artist's sales but no take-home, rather than guessing 0% or 100%.
model ArtistPayTerms {
  artistId              String   @id
  // 4500 = 45.00%. Basis points, not a float, for the same reason money is
  // in cents. A CHECK constraint (hand-written in the migration) keeps it
  // within 0-10000.
  commissionBasisPoints Int
  updatedAt             DateTime @updatedAt

  artist Artist @relation(fields: [artistId], references: [id])
}

// A fixed amount charged to the artist each time they perform this service
// (e.g. supplies), taken out of their pay. No row = no fee.
model ServicePayTerms {
  serviceId       String   @id
  serviceFeeCents Int
  updatedAt       DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id])
}

// The commission rate in effect when this appointment was checked out, so a
// later rate change doesn't rewrite a past pay period (same reasoning as
// AppointmentService's price snapshot). Written once at checkout, or — for
// an appointment checked out before its artist had a rate — when the rate is
// first saved (backfilled = true, which the report notes).
model AppointmentPay {
  appointmentId         String   @id
  commissionBasisPoints Int
  backfilled            Boolean  @default(false)
  createdAt             DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
}

// The service fee in effect for one service line when its appointment was
// checked out. Cascade with the line: a line is only replaced while its
// appointment is open, and a re-completed appointment snapshots again.
model AppointmentServicePay {
  appointmentServiceId String @id
  serviceFeeCents      Int

  appointmentService AppointmentService @relation(fields: [appointmentServiceId], references: [id], onDelete: Cascade)
}

model AppSettings {
  id                      Int     @id @default(1)
  bookingEnabled          Boolean @default(true)
  // How many hours before an appointment a customer can still cancel or
  // reschedule it online (admins are never limited).
  cancellationNoticeHours Int     @default(24)
  // Longest a standing appointment may run, in weeks — every week is booked
  // at creation, so this also bounds how much of a calendar one request claims.
  maxSeriesWeeks          Int     @default(52)
}

// Text messages (SMS, through Twilio). See src/lib/sms-consent-data.ts and
// docs/SMS_10DLC.md.

enum SmsConsentAction {
  OPTED_IN // ticked the box on the site
  CONFIRMED // replied YES from the number
  OPTED_OUT // unticked the box, replied STOP, changed number, or the carrier reports the number blocked
}

// Proof of consent: carriers can ask a sender to show when and how a number
// agreed to texts. Append-only, like the credit ledger — never updated or
// deleted.
model SmsConsentEvent {
  id                String           @id @default(cuid())
  userId            String
  // E.164 ("+16315550143").
  phone             String
  action            SmsConsentAction
  // Where it happened: "register", "account", "sms_reply", "phone_changed",
  // "carrier" (Twilio refused a send because the number opted out).
  source            String
  // OPTED_IN only: which wording of the opt-in disclosure was on screen
  // (SMS_CONSENT_VERSION in src/lib/sms-consent.ts).
  disclosureVersion String?
  createdAt         DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([phone, createdAt])
}

enum SmsKind {
  OPT_IN_REQUEST
  BOOKING_CONFIRMATION
  RECURRING_CONFIRMATION
  RESCHEDULE
  CANCELLATION
  RECURRING_CANCELLATION
  REMINDER
}

// Every text the app tried to send, and what became of it. Twilio's status
// callback (POST /api/sms/status) updates `status` by providerSid.
model SmsMessage {
  id            String   @id @default(cuid())
  userId        String
  appointmentId String?
  kind          SmsKind
  // E.164.
  to            String
  body          String
  // Twilio's message SID (SM...); null when the send never reached Twilio.
  providerSid   String?  @unique
  // Twilio's status ("queued", "sent", "delivered", "undelivered",
  // "failed"), or "not_sent" when the request to Twilio itself failed.
  status        String
  // Twilio's error code, e.g. "21610" (the number replied STOP).
  errorCode     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([userId, createdAt])
  @@index([appointmentId])
}
