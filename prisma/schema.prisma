// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

model Service {
  id              String   @id @default(cuid())
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  appointments          Appointment[]
  recurringAppointments RecurringAppointment[]
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  phone             String
  passwordHash      String?
  // Stamped on every successful password reset. Compared against a JWT
  // session's `iat` claim in src/auth.ts so a reset invalidates any session
  // that predates it — the JWT strategy has no server-side session row to
  // delete, so this is the substitute revocation mechanism. Null means
  // "never reset," which correctly invalidates nothing.
  passwordChangedAt DateTime?
  role              Role      @default(CUSTOMER)
  createdAt         DateTime  @default(now())

  appointments          Appointment[]
  accounts              Account[]
  sessions              Session[]
  recurringAppointments RecurringAppointment[]
  passwordResetTokens   PasswordResetToken[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Deliberately separate from VerificationToken above, even though that table
// is currently unused (it exists only for Auth.js's Email/magic-link
// provider, which this project doesn't use). Reusing it would mean storing a
// hashed reset token in a table Auth.js semantically owns — its composite PK
// has no userId relation and no "used" column — and the two purposes would
// collide the moment an email-verification provider is ever added.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  // SHA-256 hash of the token, never the plaintext — a DB leak would
  // otherwise hand over live account takeover. Unique because it's looked up
  // directly by hash (the plaintext, only ever known to the emailed link,
  // never touches the database).
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Cascade, not this schema's usual RESTRICT default — same reasoning as
  // Account/Session above: a reset token has no independent meaning once its
  // user is gone.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Artist {
  id        String   @id @default(cuid())
  name      String
  bio       String?
  photoUrl  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  portfolio             PortfolioImage[]
  availability          Availability[]
  timeOff               TimeOff[]
  appointments          Appointment[]
  slots                 AppointmentSlot[]
  recurringAppointments RecurringAppointment[]
}

model PortfolioImage {
  id        String   @id @default(cuid())
  artistId  String
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())

  artist Artist @relation(fields: [artistId], references: [id])
}

// Scheduling
enum AppointmentStatus {
  UPCOMING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

model RecurringAppointment {
  id            String          @id @default(cuid())
  userId        String
  artistId      String
  serviceId     String
  dayOfWeek     Int
  startTime     String
  intervalWeeks Int
  seriesStart   DateTime
  seriesEnd     DateTime?
  status        RecurringStatus @default(ACTIVE)
  createdAt     DateTime        @default(now())

  user         User          @relation(fields: [userId], references: [id])
  artist       Artist        @relation(fields: [artistId], references: [id])
  service      Service       @relation(fields: [serviceId], references: [id])
  appointments Appointment[]
}

model Appointment {
  id                     String            @id @default(cuid())
  userId                 String
  artistId               String
  serviceId              String
  startTime              DateTime
  endTime                DateTime
  status                 AppointmentStatus @default(UPCOMING)
  createdAt              DateTime          @default(now())
  recurringAppointmentId String?
  paymentMethod          PaymentMethod?
  checkedOutAt           DateTime?

  user                 User                  @relation(fields: [userId], references: [id])
  artist               Artist                @relation(fields: [artistId], references: [id])
  service              Service               @relation(fields: [serviceId], references: [id])
  slots                AppointmentSlot[]
  recurringAppointment RecurringAppointment? @relation(fields: [recurringAppointmentId], references: [id])
}

model AppointmentSlot {
  id            String   @id @default(cuid())
  artistId      String
  slotStart     DateTime
  appointmentId String

  artist      Artist      @relation(fields: [artistId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@unique([artistId, slotStart])
}

model Availability {
  id        String @id @default(cuid())
  artistId  String
  dayOfWeek Int
  startTime String
  endTime   String

  artist Artist @relation(fields: [artistId], references: [id])
}

model TimeOff {
  id        String    @id @default(cuid())
  // Nullable = salon-wide (blocks every artist, present and future — see
  // PLAN_SALON_CLOSURES.md for why this beats a list of artist ids: a list
  // has to be re-populated by hand every time staff changes, while null
  // covers everyone with zero maintenance). A concrete id keeps the original
  // per-artist behavior unchanged.
  artistId  String?
  date      DateTime
  // Nullable = single-day (today's behavior, unchanged). A value makes the
  // range [date, endDate] inclusive — a multi-day closure without needing
  // one row per day.
  endDate   DateTime?
  startTime String
  endTime   String

  artist Artist? @relation(fields: [artistId], references: [id])
}

model AppSettings {
  id             Int     @id @default(1)
  bookingEnabled Boolean @default(true)
}
