// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

model Service {
  id              String   @id @default(cuid())
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  appointmentServices          AppointmentService[]
  recurringAppointmentServices RecurringAppointmentService[]
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  phone             String
  passwordHash      String?
  // Stamped on every successful password reset. Compared against a JWT
  // session's `iat` claim in src/auth.ts so a reset invalidates any session
  // that predates it — the JWT strategy has no server-side session row to
  // delete, so this is the substitute revocation mechanism. Null means
  // "never reset," which correctly invalidates nothing.
  passwordChangedAt DateTime?
  role              Role      @default(CUSTOMER)
  createdAt         DateTime  @default(now())

  appointments          Appointment[]
  accounts              Account[]
  sessions              Session[]
  recurringAppointments RecurringAppointment[]
  passwordResetTokens   PasswordResetToken[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Deliberately separate from VerificationToken above, even though that table
// is currently unused (it exists only for Auth.js's Email/magic-link
// provider, which this project doesn't use). Reusing it would mean storing a
// hashed reset token in a table Auth.js semantically owns — its composite PK
// has no userId relation and no "used" column — and the two purposes would
// collide the moment an email-verification provider is ever added.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  // SHA-256 hash of the token, never the plaintext — a DB leak would
  // otherwise hand over live account takeover. Unique because it's looked up
  // directly by hash (the plaintext, only ever known to the emailed link,
  // never touches the database).
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Cascade, not this schema's usual RESTRICT default — same reasoning as
  // Account/Session above: a reset token has no independent meaning once its
  // user is gone.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Artist {
  id        String   @id @default(cuid())
  name      String
  bio       String?
  photoUrl  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  portfolio             PortfolioImage[]
  availability          Availability[]
  timeOff               TimeOff[]
  appointments          Appointment[]
  slots                 AppointmentSlot[]
  recurringAppointments RecurringAppointment[]
}

model PortfolioImage {
  id        String   @id @default(cuid())
  artistId  String
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())

  artist Artist @relation(fields: [artistId], references: [id])
}

// Scheduling
enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// A standing appointment can only be cancelled — there is no pause and no
// editing. Individual occurrences are ordinary Appointments and are
// rescheduled/cancelled like any other.
enum RecurringStatus {
  ACTIVE
  CANCELLED
}

// How an appointment's price is reduced. PERCENT: discountValue is a whole
// percentage (1-100). AMOUNT: discountValue is cents off.
enum DiscountType {
  PERCENT
  AMOUNT
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

model RecurringAppointment {
  id            String          @id @default(cuid())
  userId        String
  artistId      String
  dayOfWeek     Int
  startTime     String
  intervalWeeks Int
  seriesStart   DateTime
  // Required: every week from seriesStart through seriesEnd is booked (or
  // recorded as skipped) when the series is created — nothing extends a
  // series afterward.
  seriesEnd     DateTime
  status        RecurringStatus @default(ACTIVE)
  createdAt     DateTime        @default(now())

  user               User                         @relation(fields: [userId], references: [id])
  artist             Artist                       @relation(fields: [artistId], references: [id])
  // One or more services, in order — every visit of the series is booked
  // with all of them.
  services           RecurringAppointmentService[]
  appointments       Appointment[]
  skippedOccurrences RecurringSkippedOccurrence[]
}

// One service of a standing appointment. No price/duration snapshot here:
// each visit takes its own snapshot when it is booked (see
// AppointmentService), which is at series creation.
model RecurringAppointmentService {
  id                     String @id @default(cuid())
  recurringAppointmentId String
  serviceId              String
  position               Int

  // Cascade, same reasoning as RecurringSkippedOccurrence: a line means
  // nothing without its series.
  recurringAppointment RecurringAppointment @relation(fields: [recurringAppointmentId], references: [id], onDelete: Cascade)
  service              Service              @relation(fields: [serviceId], references: [id])

  @@unique([recurringAppointmentId, serviceId])
}

// A week of a standing appointment that couldn't be booked (a conflict, the
// artist was deactivated, ...). Recorded once and never retried, so it can
// be shown on the series and emailed to the customer exactly once.
model RecurringSkippedOccurrence {
  id                     String   @id @default(cuid())
  recurringAppointmentId String
  // "YYYY-MM-DD", same identity format as Appointment.occurrenceDate.
  occurrenceDate         String
  reason                 String
  createdAt              DateTime @default(now())

  // Cascade, a deliberate exception to this schema's RESTRICT default (same
  // reasoning as Account/Session): a skip record means nothing without its
  // series.
  recurringAppointment RecurringAppointment @relation(fields: [recurringAppointmentId], references: [id], onDelete: Cascade)

  @@unique([recurringAppointmentId, occurrenceDate])
}

model Appointment {
  id                     String            @id @default(cuid())
  userId                 String
  artistId               String
  startTime              DateTime
  endTime                DateTime
  status                 AppointmentStatus @default(PENDING)
  createdAt              DateTime          @default(now())
  recurringAppointmentId String?
  paymentMethod          PaymentMethod?
  checkedOutAt           DateTime?
  // Optional discount an admin applied before checkout — both set or both
  // null. Record-keeping only, like checkout itself: the POS takes the
  // payment, this is what the receipt and the schedule show. The total is
  // derived from the services' booked prices (see src/lib/discount.ts), not
  // stored.
  discountType           DiscountType?
  discountValue          Int?
  // Set once the 24h reminder email has gone out (or once some other email
  // already told the customer about an imminent time — see
  // src/lib/appointment-emails.ts). The reminder job claims rows by flipping
  // this from null, so a reminder can never send twice. Reset to null on
  // reschedule, since the old reminder was for the old time.
  reminderSentAt         DateTime?
  // Which week of its series this row was materialized for ("YYYY-MM-DD"),
  // null for one-off appointments. Set once and never changed by a
  // reschedule, so a moved occurrence still counts as "handled" for its
  // original date. A string rather than a DateTime on purpose: it's compared
  // by exact equality, and a DateTime "date" is local midnight stored as a
  // UTC instant, which can silently fail to match if computed differently.
  occurrenceDate         String?

  user                 User                  @relation(fields: [userId], references: [id])
  artist               Artist                @relation(fields: [artistId], references: [id])
  // One or more services, in order. The appointment's price is the sum of
  // their booked prices; its usual length is the sum of their durations
  // (startTime..endTime is still the truth for the actual length).
  services             AppointmentService[]
  slots                AppointmentSlot[]
  recurringAppointment RecurringAppointment? @relation(fields: [recurringAppointmentId], references: [id])

  // Each week of a series can be materialized at most once — the database,
  // not careful call-site logic, is what makes a concurrent job run or a
  // job racing a Resume click harmless (same instinct as AppointmentSlot's
  // unique constraint). Postgres treats NULLs as distinct, so one-off
  // appointments (both columns null) are unaffected.
  @@unique([recurringAppointmentId, occurrenceDate])
}

// One service on an appointment. priceCents and durationMinutes are copied
// from the Service when the line is added, so a past appointment (and its
// receipt) keeps what it was booked at even if the service is repriced later.
model AppointmentService {
  id              String @id @default(cuid())
  appointmentId   String
  serviceId       String
  position        Int
  priceCents      Int
  durationMinutes Int

  // Cascade: a line means nothing without its appointment. The Service side
  // stays RESTRICT — a booked service is retired via Service.active, never
  // deleted.
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@unique([appointmentId, serviceId])
}

model AppointmentSlot {
  id            String   @id @default(cuid())
  artistId      String
  slotStart     DateTime
  appointmentId String

  artist      Artist      @relation(fields: [artistId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@unique([artistId, slotStart])
}

model Availability {
  id        String @id @default(cuid())
  artistId  String
  dayOfWeek Int
  startTime String
  endTime   String

  artist Artist @relation(fields: [artistId], references: [id])
}

model TimeOff {
  id        String    @id @default(cuid())
  // Nullable = salon-wide (blocks every artist, present and future — see
  // PLAN_SALON_CLOSURES.md for why this beats a list of artist ids: a list
  // has to be re-populated by hand every time staff changes, while null
  // covers everyone with zero maintenance). A concrete id keeps the original
  // per-artist behavior unchanged.
  artistId  String?
  date      DateTime
  // Nullable = single-day (today's behavior, unchanged). A value makes the
  // range [date, endDate] inclusive — a multi-day closure without needing
  // one row per day.
  endDate   DateTime?
  startTime String
  endTime   String

  artist Artist? @relation(fields: [artistId], references: [id])
}

model AppSettings {
  id             Int     @id @default(1)
  bookingEnabled Boolean @default(true)
}
