# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (Neon). Prefer sslmode=verify-full — pg
# currently treats "require" as verify-full and warns that this will change.
DATABASE_URL=

# Auth.js signing/encryption secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# The site's own URL. Not needed for `next dev`, but REQUIRED for a
# production build (`next start`, or the deployed site): without it Auth.js
# rejects every sign-in with "UntrustedHost". e.g. http://localhost:3000
# An https:// value also turns on the HSTS header (read at build time).
AUTH_URL=

# Cloudinary — admin photo/portfolio uploads. Without these, the upload
# signing route returns "Image upload is not configured". The cloud name
# also scopes which image URLs the API and next/image accept, and is read at
# BUILD time — a production build refuses to start without it.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — transactional email. Leave RESEND_API_KEY empty in development to
# print emails to the console instead of sending them (in a production build
# a missing key sends and prints nothing). Sending from the salon's own
# domain requires verifying it in Resend (SPF/DKIM).
RESEND_API_KEY=
EMAIL_FROM=
# Base URL used in email links, e.g. http://localhost:3000. Inlined at BUILD
# time — a production build refuses to start without it.
NEXT_PUBLIC_APP_URL=

# Shared secret for scheduled job routes (POST /api/jobs/send-reminders).
# The scheduler sends "Authorization: Bearer <this>". Unset = route returns 503.
CRON_SECRET=

# Optional monitoring (docs/DEPLOY_RUNBOOK.md §11). Server errors are always
# logged as one JSON line; with a Slack or Discord incoming-webhook URL here
# a short summary is also posted there. CRON_HEARTBEAT_URL is pinged after
# each reminder run (e.g. a Healthchecks.io check). Leave both empty locally.
ERROR_ALERT_WEBHOOK_URL=
CRON_HEARTBEAT_URL=

# Optional, for `npx prisma db seed` (prisma/seed.ts). With nothing set the
# seed creates only the AppSettings row. SEED_ADMIN_* seeds that admin.
# SEED_DEV_DATA=1 (local development ONLY — never against production) adds a
# demo artist/service and, without SEED_ADMIN_*, the dev admin login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEV_DATA=
