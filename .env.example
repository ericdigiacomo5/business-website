# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (Neon). Prefer sslmode=verify-full — pg
# currently treats "require" as verify-full and warns that this will change.
DATABASE_URL=

# Auth.js signing/encryption secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# The site's own URL. Not needed for `next dev`, but REQUIRED for a
# production build (`next start`, or the deployed site): without it Auth.js
# rejects every sign-in with "UntrustedHost". e.g. http://localhost:3000
AUTH_URL=

# Google OAuth (Google Cloud Console > APIs & Services > Credentials, type
# "Web application"). Authorized redirect URI for local dev:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cloudinary — admin photo/portfolio uploads. Without these, the upload
# signing route returns "Image upload is not configured". The cloud name
# also scopes which image URLs the API and next/image accept.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — transactional email. Leave RESEND_API_KEY empty in development to
# print emails to the console instead of sending them. Sending from the
# salon's own domain requires verifying it in Resend (SPF/DKIM).
RESEND_API_KEY=
EMAIL_FROM=
# Base URL used in email links, e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Shared secret for scheduled job routes (POST /api/jobs/send-reminders).
# The scheduler sends "Authorization: Bearer <this>". Unset = route returns 503.
CRON_SECRET=

# Optional: credentials for the seeded admin (prisma/seed.ts). Required when
# seeding with NODE_ENV=production; otherwise a dev default is used.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
